-- PLAYER ENTRIES
local function addPlayer(target)
    if target == player then return end

    local entryName = "Player_" .. target.UserId
    if list:FindFirstChild(entryName) then return end

    local entry = Instance.new("Frame")
    entry.Name = entryName
    entry.Size = UDim2.new(1, -6, 0, 62)
    entry.BackgroundColor3 = DARK
    entry.BorderSizePixel = 0
    entry.Parent = list

    Instance.new("UICorner", entry).CornerRadius =
        UDim.new(0, 8)

    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.fromOffset(42, 42)
    avatar.Position = UDim2.fromOffset(7, 10)
    avatar.BackgroundColor3 = BLACK
    avatar.BorderSizePixel = 0
    avatar.Parent = entry

    Instance.new("UICorner", avatar).CornerRadius =
        UDim.new(1, 0)

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                target.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)

        if ok and avatar.Parent then
            avatar.Image = image
        end
    end)

    local name = Instance.new("TextLabel")
    name.Position = UDim2.fromOffset(56, 4)
    name.Size = UDim2.new(1, -62, 0, 22)
    name.BackgroundTransparency = 1
    name.Text = target.Name
    name.TextColor3 = WHITE
    name.Font = Enum.Font.GothamMedium
    name.TextSize = 12
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.TextTruncate = Enum.TextTruncate.AtEnd
    name.Parent = entry

    local block = Instance.new("TextButton")
    block.Position = UDim2.fromOffset(56, 29)
    block.Size = UDim2.new(1, -62, 0, 26)
    block.BackgroundColor3 = Color3.fromRGB(190, 20, 40)
    block.Text = "INSTANT BLOCK"
    block.TextColor3 = WHITE
    block.Font = Enum.Font.GothamBold
    block.TextSize = 11
    block.BorderSizePixel = 0
    block.Parent = entry

    Instance.new("UICorner", block).CornerRadius =
        UDim.new(0, 6)

    block.Activated:Connect(function()
        if target.Parent ~= Players then return end

        local ok, err = pcall(function()
            StarterGui:SetCore("PromptBlockPlayer", target)
        end)

        if not ok then
            warn("Roblox block prompt unavailable: " .. tostring(err))
        end
    end)
end

local function removePlayer(target)
    local entry = list:FindFirstChild("Player_" .. target.UserId)
    if entry then entry:Destroy() end
end

for _, target in ipairs(Players:GetPlayers()) do
    addPlayer(target)
end

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- DRAG PANEL: mouse and touch
local dragging = false
local dragStart
local startPosition
local dragInput

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        dragInput = nil
    end
end)
